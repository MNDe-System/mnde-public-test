# Paths only: provision the actual files separately. No keys/tokens in this file.
MNDE_PROFILE=production
MNDE_HUB_DATA_DIR=/mnt/mnde-data/hub
MNDE_HUB_PORT=8790
MNDE_HUB_OPERATORS='["operator"]'
MNDE_SIDECAR_AUTH=bearer
MNDE_SIDECAR_AUTH_TOKENS_FILE=/etc/mnde/api-tokens.json
MNDE_GIT_PUSH_REPO_PATH=/var/lib/mnde/repository
MNDE_GIT_PUSH_NAMESPACE=mnde-hub
MNDE_GIT_PUSH_EVIDENCE_DIR=/mnt/mnde-data/evidence
MNDE_GIT_PUSH_ALLOWED_SCHEMES=https
MNDE_GIT_CREDENTIAL_CONFIG=/etc/mnde/git-credential.json
MNDE_CLAIM_CONFIG=/etc/mnde/claim.json
MNDE_VERIFY_AUTHORITY_BUNDLE=/etc/mnde/authority-bundle.json
MNDE_VERIFY_TRUSTED_ROOT_FINGERPRINT=REPLACE_WITH_APPROVED_ROOT_FINGERPRINT
MNDE_VERIFY_ENVIRONMENT_ID=prod
MNDE_VERIFY_EXPECTED_EXECUTOR_ID=REPLACE_WITH_ENROLLED_EXECUTOR_ID
MNDE_EXECUTOR_ID=REPLACE_WITH_ENROLLED_EXECUTOR_ID
MNDE_EXECUTOR_PRIVATE_KEY=/etc/mnde/executor-private.pem
MNDE_EXECUTOR_CREDENTIAL=/etc/mnde/executor-credential.json
MNDE_EXECUTOR_ENVIRONMENT=prod
MNDE_AUTHORITY_BUNDLE=/etc/mnde/authority-bundle.json
MNDE_RECEIPT_SIGNING_KEY=/etc/mnde/receipt-private.pem
MNDE_PE_POLICY_BUNDLE=/etc/mnde/policy-bundle.json
MNDE_PE_AUTHORITY_BUNDLE=/etc/mnde/authority-bundle.json
MNDE_PE_TRUSTED_ROOT_FINGERPRINT=REPLACE_WITH_APPROVED_ROOT_FINGERPRINT
MNDE_PE_POLICY_BUNDLE_STATE=/mnt/mnde-data/policy-bundle-state.json
MNDE_PE_APPROVAL_TRUST_ANCHORS=/etc/mnde/approval-anchors.json
