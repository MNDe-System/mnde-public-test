# Copy to .env for optional local settings. Never put credentials in this file.
MNDE_PROFILE=local
MNDE_BIND_PORT=8787
MNDE_HUB_DISCOVERY=1
# For a Hub reachable across Tailscale, enter its 100.64.0.0/10 IPv4 address:
# MNDE_HUB_IP=100.101.102.103
# Optional fixed location for generated keys and receipts (outside this checkout):
# MNDE_HOME=C:\Users\you\AppData\Local\MNDe\app-runtime
